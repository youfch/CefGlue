<Project>
    <Target Name="CopyCefGlueBrowserProcess_Jit" AfterTargets="AfterBuild"
            Condition="Exists('$(_CefGlueBpBinDir)')">
        <ItemGroup>
            <_CefGlueBpFiles Include="$(_CefGlueBpBinDir)*" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpFiles)" DestinationFolder="$(OutputPath)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <FileWrites Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <_CefGlueBpOutputFiles Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <ResolvedFileToPublish Include="@(_CefGlueBpOutputFiles)">
                <RelativePath>CefGlueBrowserProcess\%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <Target Name="CopyCefGlueBrowserProcess_JitPublish" AfterTargets="Publish"
            DependsOnTargets="CopyCefGlueBrowserProcess_Jit"
            Condition="Exists('$(_CefGlueBpBinDir)')" />
</Project>
