<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir>CefGlueBrowserProcess</CefGlueBrowserProcessDir>
        <!--
          Map CefGlueTargetPlatform -> NuGet Pkg property name for the corresponding JIT platform sub-package.
          NuGet auto-generates Pkg<PackageId> where dots become underscores.
        -->
        <_CefGlueBpPkgName Condition="'$(CefGlueTargetPlatform)' == 'win-x64'">CefGlue_BrowserProcess_runtime_win_x64_jit</_CefGlueBpPkgName>
        <_CefGlueBpPkgName Condition="'$(CefGlueTargetPlatform)' == 'win-arm64'">CefGlue_BrowserProcess_runtime_win_arm64_jit</_CefGlueBpPkgName>
        <_CefGlueBpPkgName Condition="'$(CefGlueTargetPlatform)' == 'linux-x64'">CefGlue_BrowserProcess_runtime_linux_x64_jit</_CefGlueBpPkgName>
        <_CefGlueBpPkgName Condition="'$(CefGlueTargetPlatform)' == 'linux-arm64'">CefGlue_BrowserProcess_runtime_linux_arm64_jit</_CefGlueBpPkgName>
        <_CefGlueBpPkgName Condition="'$(CefGlueTargetPlatform)' == 'osx-x64'">CefGlue_BrowserProcess_runtime_osx_x64_jit</_CefGlueBpPkgName>
        <_CefGlueBpPkgName Condition="'$(CefGlueTargetPlatform)' == 'osx-arm64'">CefGlue_BrowserProcess_runtime_osx_arm64_jit</_CefGlueBpPkgName>
        <!-- The build\bin\<rid>.jit sub-folder inside the sub-package that contains the published binaries -->
        <_CefGlueBpBinDir Condition="'$(CefGlueTargetPlatform)' == 'win-x64'">$(PkgCefGlue_BrowserProcess_runtime_win_x64_jit)\build\bin\win-x64.jit\</_CefGlueBpBinDir>
        <_CefGlueBpBinDir Condition="'$(CefGlueTargetPlatform)' == 'win-arm64'">$(PkgCefGlue_BrowserProcess_runtime_win_arm64_jit)\build\bin\win-arm64.jit\</_CefGlueBpBinDir>
        <_CefGlueBpBinDir Condition="'$(CefGlueTargetPlatform)' == 'linux-x64'">$(PkgCefGlue_BrowserProcess_runtime_linux_x64_jit)\build\bin\linux-x64.jit\</_CefGlueBpBinDir>
        <_CefGlueBpBinDir Condition="'$(CefGlueTargetPlatform)' == 'linux-arm64'">$(PkgCefGlue_BrowserProcess_runtime_linux_arm64_jit)\build\bin\linux-arm64.jit\</_CefGlueBpBinDir>
        <_CefGlueBpBinDir Condition="'$(CefGlueTargetPlatform)' == 'osx-x64'">$(PkgCefGlue_BrowserProcess_runtime_osx_x64_jit)\build\bin\osx-x64.jit\</_CefGlueBpBinDir>
        <_CefGlueBpBinDir Condition="'$(CefGlueTargetPlatform)' == 'osx-arm64'">$(PkgCefGlue_BrowserProcess_runtime_osx_arm64_jit)\build\bin\osx-arm64.jit\</_CefGlueBpBinDir>
    </PropertyGroup>
</Project>