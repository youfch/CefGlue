<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DotnetVersion)</TargetFramework>
    <PackageId>CefGlue.BrowserProcess.runtime.win-arm64.jit</PackageId>
    <Version>$(Version)</Version>
    <Authors>$(Authors)</Authors>
    <Description>Self-contained JIT BrowserProcess binary for win-arm64 (~72 MB with .NET runtime). Install alongside CefGlue.Common.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5100;NU5118</NoWarn>
  </PropertyGroup>
  <ItemGroup>
        <None Include="build\**" Pack="True" PackagePath="build\" />
    <None Include="build\*.targets" Pack="True" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
