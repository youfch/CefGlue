<!--
  CefGlue BrowserProcess common build logic.
  Shared across all platform-specific BrowserProcess runtime packages.
  
  Required properties (set by the platform-specific .targets before importing):
    _CefGlueBpBinDir         - full path to bin directory containing BrowserProcess files
    _CefGlueBpPlatformId     - platform identifier, e.g. "win-x64"
    _CefGlueBpExcludePattern - file pattern to exclude (optional), e.g. "*.pdb"
-->
<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir Condition="'$(CefGlueBrowserProcessDir)' == ''">CefGlueBrowserProcess</CefGlueBrowserProcessDir>
    </PropertyGroup>

    <Target Name="CopyCefGlueBrowserProcess_$(_CefGlueBpPlatformId)" AfterTargets="AfterBuild"
            Condition="'$(CefGlueTargetPlatform)' == '$(_CefGlueBpPlatformId)'">
        <ItemGroup>
            <_CefGlueBpFiles Include="$(_CefGlueBpBinDir)*" />
            <_CefGlueBpFiles Remove="$(_CefGlueBpBinDir)$(_CefGlueBpExcludePattern)"
                             Condition="'$(_CefGlueBpExcludePattern)' != ''" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpFiles)" DestinationFolder="$(OutputPath)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <FileWrites Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <_CefGlueBpOutputFiles Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <ResolvedFileToPublish Include="@(_CefGlueBpOutputFiles)">
                <RelativePath>CefGlueBrowserProcess\%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <Target Name="CopyCefGlueBrowserProcess_$(_CefGlueBpPlatformId)Publish" AfterTargets="Publish"
            DependsOnTargets="CopyCefGlueBrowserProcess_$(_CefGlueBpPlatformId)"
            Condition="'$(CefGlueTargetPlatform)' == '$(_CefGlueBpPlatformId)'" />
</Project>
