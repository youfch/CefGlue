<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir>CefGlueBrowserProcess</CefGlueBrowserProcessDir>
    </PropertyGroup>
    <Target Name="CopyCefGlueBrowserProcess_OSX_x64" AfterTargets="AfterBuild"
            Condition="'$(CefGlueTargetPlatform)' == 'osx-x64'">
        <ItemGroup>
            <_CefGlueBpFiles Include="$(MSBuildThisFileDirectory)..\build\bin\osx-x64\*"
                             Exclude="$(MSBuildThisFileDirectory)..\build\bin\osx-x64\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpFiles)" DestinationFolder="$(OutputPath)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <FileWrites Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <_CefGlueBpOutputFiles Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <ResolvedFileToPublish Include="@(_CefGlueBpOutputFiles)">
                <RelativePath>CefGlueBrowserProcess\%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
    <Target Name="CopyCefGlueBrowserProcess_OSX_x64Publish" AfterTargets="Publish"
            DependsOnTargets="CopyCefGlueBrowserProcess_OSX_x64"
            Condition="'$(CefGlueTargetPlatform)' == 'osx-x64'" />
</Project>