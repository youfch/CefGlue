<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir>CefGlueBrowserProcess</CefGlueBrowserProcessDir>
    </PropertyGroup>
    <Target Name="CopyCefGlueBrowserProcess_Win_x64" AfterTargets="AfterBuild"
            Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <ItemGroup>
<_CefGlueBpFiles Include="$(MSBuildThisFileDirectory)..\build\bin\win-x64\*"
							 Exclude="$(MSBuildThisFileDirectory)..\build\bin\win-x64\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpFiles)" DestinationFolder="$(OutputPath)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <FileWrites Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <_CefGlueBpOutputFiles Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <ResolvedFileToPublish Include="@(_CefGlueBpOutputFiles)">
                <RelativePath>CefGlueBrowserProcess\%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
    <Target Name="CopyCefGlueBrowserProcess_Win_x64Publish" AfterTargets="Publish"
            DependsOnTargets="CopyCefGlueBrowserProcess_Win_x64"
            Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
</Project>