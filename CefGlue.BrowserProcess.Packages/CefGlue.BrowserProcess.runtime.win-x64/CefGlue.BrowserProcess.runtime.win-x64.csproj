<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DotnetVersion)</TargetFramework>
    <PackageId>CefGlue.BrowserProcess.runtime.win-x64</PackageId>
    <Version>$(Version)</Version>
    <Authors>$(Authors)</Authors>
    <Description>NativeAOT BrowserProcess binary for win-x64 (~11 MB single .exe). Install alongside CefGlue.Common.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5100;NU5118</NoWarn>
  </PropertyGroup>

  <ItemGroup>
        <None Include="build\**" Pack="True" PackagePath="build\" />
    <None Include="build\*.targets" Pack="True" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
