<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DotnetVersion)</TargetFramework>
    <PackageId>CefGlue.BrowserProcess.runtime.osx-arm64</PackageId>
    <Version>$(Version)</Version>
    <Authors>$(Authors)</Authors>
    <Description>NativeAOT BrowserProcess binary for osx-arm64 (~50 MB single file). Install alongside CefGlue.Common.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5100;NU5118</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build\**" Pack="True" PackagePath="build\" />
  </ItemGroup>
</Project>