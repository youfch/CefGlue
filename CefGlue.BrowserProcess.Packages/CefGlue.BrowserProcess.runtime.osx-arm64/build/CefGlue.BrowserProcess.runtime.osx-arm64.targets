<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir>CefGlueBrowserProcess</CefGlueBrowserProcessDir>
    </PropertyGroup>
    <Target Name="CopyCefGlueBrowserProcess_OSX_arm64" AfterTargets="AfterBuild"
            Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <ItemGroup>
            <_CefGlueBpFiles Include="$(MSBuildThisFileDirectory)..\build\bin\osx-arm64\*"
                             Exclude="$(MSBuildThisFileDirectory)..\build\bin\osx-arm64\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpFiles)" DestinationFolder="$(OutputPath)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <FileWrites Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <_CefGlueBpOutputFiles Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <ResolvedFileToPublish Include="@(_CefGlueBpOutputFiles)">
                <RelativePath>CefGlueBrowserProcess\%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
    <Target Name="CopyCefGlueBrowserProcess_OSX_arm64Publish" AfterTargets="Publish"
            DependsOnTargets="CopyCefGlueBrowserProcess_OSX_arm64"
            Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
</Project>