<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir>CefGlueBrowserProcess</CefGlueBrowserProcessDir>
    </PropertyGroup>
    <Target Name="CopyCefGlueBrowserProcess_OSX_arm64_jit" AfterTargets="AfterBuild"
            Condition="'$(CefGlueTargetPlatform)' == 'osx-arm64'">
        <ItemGroup>
            <_CefGlueBpFiles Include="$(MSBuildThisFileDirectory)..\build\bin\osx-arm64.jit\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpFiles)" DestinationFolder="$(OutputPath)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
        <ItemGroup>
            <FileWrites Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <_CefGlueBpOutputFiles Include="$(OutputPath)$(CefGlueBrowserProcessDir)\**\*" />
            <ResolvedFileToPublish Include="@(_CefGlueBpOutputFiles)">
                <RelativePath>CefGlueBrowserProcess\%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
    <Target Name="CopyCefGlueBrowserProcess_OSX_arm64_jitPublish" AfterTargets="Publish"
            DependsOnTargets="CopyCefGlueBrowserProcess_OSX_arm64_jit"
            Condition="'$(CefGlueTargetPlatform)' == 'osx-arm64'" />
</Project>