<Project>
    <PropertyGroup>
        <CefGlueBrowserProcessDir Condition="'$(CefGlueBrowserProcessDir)' == ''">CefGlueBrowserProcess</CefGlueBrowserProcessDir>
    </PropertyGroup>

    <Target Name="CopyCefGlueBrowserProcess_linux-x64" AfterTargets="AfterBuild"
            Condition="'$(CefGlueTargetPlatform)' == 'linux-x64'">
        <ItemGroup>
            <_CefGlueBpFiles Include="$(MSBuildThisFileDirectory)..\build\bin\linux-x64\*" />
            <_CefGlueBpFiles Remove="$(MSBuildThisFileDirectory)..\build\bin\linux-x64\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpFiles)" DestinationFolder="$(OutputPath)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyCefGlueBrowserProcess_linux-x64Publish" AfterTargets="Publish"
            Condition="'$(CefGlueTargetPlatform)' == 'linux-x64'">
        <ItemGroup>
            <_CefGlueBpPublishFiles Include="$(OutputPath)$(CefGlueBrowserProcessDir)\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_CefGlueBpPublishFiles)" DestinationFolder="$(PublishDir)$(CefGlueBrowserProcessDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>